# ==========================================
# Telephony Carrier Settings (TeleCMI / Twilio)
# ==========================================
# For TeleCMI: Get your Application ID & DID Virtual Number from your TeleCMI portal
AGENT_ID=your_telecmi_agent_or_app_id
AGENT_TOKEN=your_telecmi_jwt_token
TELECMI_APP_ID=your_telecmi_app_id
TELECMI_APP_SECRET=your_telecmi_app_secret
TELECMI_TOKEN=your_telecmi_jwt_token
TELECMI_PHONE_NUMBER=91XXXXXXXXXX
TELECMI_PIOPIY_APP_ID=your_telecmi_app_id
TELECMI_WEBHOOK_TOKEN=your_shared_webhook_secret

# Fallback: Twilio (if using Twilio carrier)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# Text-to-Speech (TTS) Settings
# ==========================================
# Free Indian Voice (Microsoft Edge Neural TTS):
TTS_VOICE=en-IN-PrabhatNeural
# Alternatives: hi-IN-MadhurNeural, en-IN-NeerjaNeural, hi-IN-SwaraNeural

# ElevenLabs Voice Configuration:
USE_ELEVENLABS=false
ELEVENLABS_API_KEY=
ELEVENLABS_KEY_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=

# ==========================================
# LLM Intelligence (Gemini / OpenAI)
# ==========================================
# Google AI Studio API key (starts with AIza...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Settings (Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# ==========================================
# Application Host & Webhook Configuration
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
NGROK_URL=http://localhost:8000

# ==========================================
# CRM & PostgreSQL Database Integrations
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/airbornedb
SUPABASE_URL=
SUPABASE_KEY=
TELECRM_API_KEY=

# ==========================================
# Automations & Campus Booking
# ==========================================
CAMPUS_BOOKING_URL=https://calendly.com/airborne-aviation/campus-visit
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=