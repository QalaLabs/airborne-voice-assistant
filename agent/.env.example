# Env vars for the ADK agent, used during local `agents run`-style dev loop.
# Agent Engine's own deploy flow may bake config differently at deploy time
# (confirm against agents-cli/ADK docs) -- this file is for local dev only.

GCP_PROJECT=airborne-aviation-505100
GCP_LOCATION=asia-south1

# Model id passed to LlmAgent (agent.py). Must match a model Agent Engine
# actually accepts -- format may differ from the raw Generative Language API
# model names used in the Cloud Run side's gpt_test.py.
AGENT_MODEL_ID=gemini-flash-latest

# RAG lookup (agent/rag_client.py) -- points at the Cloud Run service's new
# /internal/rag/query endpoint. Must match INTERNAL_RAG_SHARED_SECRET set on
# the Cloud Run deploy (see repo root .env.example / deploy.sh).
RAG_ENDPOINT_URL=https://airborne-voice-assistant-368523757732.asia-south1.run.app/internal/rag/query
INTERNAL_RAG_SHARED_SECRET=
